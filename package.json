{
  "name": "orchestra",
  "version": "0.1.0",
  "description": "Always-on AI financial agent for onchain portfolio management — ETHGlobal Cannes 2025",
  "main": "src/integrations/ledger/serve.ts",
  "scripts": {
    "dev": "npx tsx src/integrations/ledger/serve.ts",
    "build": "tsc",
    "start": "node dist/integrations/ledger/serve.js",
    "ledger:bridge": "npx tsx src/integrations/ledger/serve.ts",
    "ledger:ui": "npx vite src/integrations/ledger/ui",
    "safe:deploy": "npx tsx src/integrations/safe/deploy.ts",
    "test": "STORAGE_BACKEND=memory npx tsx src/policy/policy.test.ts && STORAGE_BACKEND=memory npx tsx src/intent/intent.test.ts && STORAGE_BACKEND=memory npx tsx src/approvals/approvals.test.ts && STORAGE_BACKEND=memory npx tsx src/integrations/telegram/telegram.test.ts && STORAGE_BACKEND=memory npx tsx src/auth/auth.test.ts && STORAGE_BACKEND=memory npx tsx src/auth/privy.test.ts && STORAGE_BACKEND=memory npx tsx src/integrations/passkey/passkey.test.ts && STORAGE_BACKEND=memory npx tsx src/integrations/uniswap/liquidity.test.ts && STORAGE_BACKEND=memory npx tsx src/integrations/zero-g/storage.test.ts",
    "test:policy": "STORAGE_BACKEND=memory npx tsx src/policy/policy.test.ts",
    "test:intent": "STORAGE_BACKEND=memory npx tsx src/intent/intent.test.ts",
    "test:approvals": "STORAGE_BACKEND=memory npx tsx src/approvals/approvals.test.ts",
    "test:telegram": "STORAGE_BACKEND=memory npx tsx src/integrations/telegram/telegram.test.ts",
    "test:auth": "STORAGE_BACKEND=memory npx tsx src/auth/auth.test.ts",
    "test:privy": "STORAGE_BACKEND=memory npx tsx src/auth/privy.test.ts",
    "test:passkey": "STORAGE_BACKEND=memory npx tsx src/integrations/passkey/passkey.test.ts",
    "test:liquidity": "STORAGE_BACKEND=memory npx tsx src/integrations/uniswap/liquidity.test.ts",
    "test:storage": "STORAGE_BACKEND=memory npx tsx src/integrations/zero-g/storage.test.ts",
    "eval": "npx tsx eval/run.ts",
    "paper": "bash paper/template/build.sh",
    "paper:tex": "bash paper/latex/build.sh"
  },
  "keywords": [
    "0g",
    "uniswap",
    "ledger",
    "safe",
    "elizaos",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "latest",
    "@0glabs/0g-serving-broker": "latest",
    "@ledgerhq/context-module": "^1.15.0",
