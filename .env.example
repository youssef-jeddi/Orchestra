# Storage: a local file by default (.orchestra/storage.json, git-ignored) — no setup needed.
# STORAGE_BACKEND=file          # file (default) | memory (nothing survives a restart) | 0g (opt-in)
# STORAGE_FILE=.orchestra/storage.json

# 0G Storage (only used with STORAGE_BACKEND=0g)
ZERO_G_PRIVATE_KEY=             # Funded wallet private key for 0G transactions (get testnet tokens from faucet.0g.ai)
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# 0G Compute
ZERO_G_PROVIDER_ADDRESS=0xa48f01287233509FD694a22Bf840225062E67836
ZERO_G_API_KEY=                 # Generate from 0G Compute marketplace UI
ZERO_G_SERVICE_URL=https://compute-network-6.integratenetwork.work/v1/proxy
# COMPUTE_PROVIDER=groq         # use 'groq' for development, '0g' for demo

# Groq (default compute provider during development)
GROQ_API_KEY=                   # Get from console.groq.com
# GROQ_MODEL=qwen/qwen3.8-27b   # planner model (see `npm run eval` for comparisons)

# Planner LLM provider: groq (default) or anthropic
# LLM_PROVIDER=groq
ANTHROPIC_API_KEY=              # Get from console.anthropic.com (only needed with LLM_PROVIDER=anthropic)
# ANTHROPIC_MODEL=claude-haiku-4-5

# Etherscan
ETHERSCAN_API_KEY=              # Get from https://etherscan.io/apis (free account)

# Uniswap
UNISWAP_API_KEY=                # Get from https://hub.uniswap.org
UNISWAP_ROUTER_ADDRESS=

# Ledger
LEDGER_DMK_API_URL=
LEDGER_WEBHOOK_SECRET=

# Safe
SAFE_FACTORY_ADDRESS=
AGENT_PRIVATE_KEY=                  # Generated EOA — run: npx tsx src/scripts/generate-agent-wallet.ts
AGENT_WALLET_ADDRESS=               # Corresponding address (needs Sepolia ETH for gas)
ORCHESTRA_POLICY_ADDRESS=           # Deployed OrchestraPolicy contract on Sepolia

# On-chain $1000/day ceiling (contracts/README.md). Empty = no module: local dev only — in production
# (NODE_ENV=production) new accounts are refused without it. A malformed value refuses every action.
#   v1 (ORC-107): AGENT_PRIVATE_KEY is the one agent for every account.
#   v2 (ORC-38):  each account gets its own agent key, stored encrypted on the server; AGENT_PRIVATE_KEY
#                 only relays signed batches and pays gas (it must hold Sepolia ETH, it can't move funds).
# The bridge asks the module which version it is; switching v1 → v2 leaves v1 accounts as old wallets.
SPENDING_MODULE_ADDRESS=
# v2 only: AES-256-GCM key for the per-account agent keys at rest. 64 hex chars: `openssl rand -hex 32`.
# REQUIRED in production (actions and new accounts are refused without it). Unset locally = a public
# dev key with a warning. Changing or losing it makes every stored agent key unreadable — back it up.
AGENT_KEY_ENCRYPTION_KEY=

# RPC
RPC_URL=
SEPOLIA_RPC_URL=                # Alchemy Sepolia: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY (defaults to a public node)
MAINNET_RPC_URL=                # Used only for ENS resolution (defaults to a public node)
CHAIN_ID=

# General
# LEDGER_APPROVAL=on            # require a Ledger above the hardware threshold ($1000); off → passkey / wallet approval
# LP_MAX_PRICE_DEVIATION=0.05  # refuse liquidity when the pool's price is this far from market; "off" for testnet demos
WATCHER_INTERVAL_MS=300000

# Telegram approvals (optional): create a bot with @BotFather and paste its token.
# When set, risky transactions for wallets that linked Telegram are approved there.
TELEGRAM_BOT_TOKEN=
# Phone passkey approvals (optional, needs Telegram): the frontend's public https
# address. The phone opens approval pages there and passkeys are bound to its domain,
# so keep it stable (changing it means setting up the phone passkey again).
# Local testing: `cloudflared tunnel --url http://localhost:3000` and paste the https URL.
PUBLIC_APP_URL=

# Privy sign-in (optional): passkey/email accounts for newcomers and WalletConnect
# wallets (MetaMask, Phantom, Coinbase, Rabby, Trust…) in one window. Create an app
# at dashboard.privy.io; the frontend reads the same app ID from this file.
# In the dashboard: enable Passkey, Email and Wallet logins, turn on identity tokens,
# and add http://localhost:3000 (and your public URL) to the allowed origins.
# Without it, the app falls back to MetaMask + Ledger.
PRIVY_APP_ID=
# Optional, server only (never NEXT_PUBLIC_): lets a passkey user approve transactions
# with their sign-in passkey instead of registering a second one ("App secret" in the dashboard).
PRIVY_APP_SECRET=
# PRIVY_VERIFICATION_KEY=       # optional: the dashboard's PEM key, instead of fetching Privy's JWKS

# Websites allowed to call the bridge from a browser (HTTP and WebSocket). Comma-separated; a request
# from any other site is refused with 403. Requests with no Origin (curl, servers) are not affected.
# Entries are exact origins or use * (`https://*.example.com` = any subdomain, `http://localhost:*` = any port).
#   local   unset → http://localhost:* and http://127.0.0.1:* (plus PUBLIC_APP_URL's origin, always allowed).
#   staging the staging frontend plus the preview pattern of your Vercel team, e.g.
#           ALLOWED_ORIGINS=https://staging.getorchestra.xyz,https://orchestra-*-<team-slug>.vercel.app
#   production (NODE_ENV=production) MUST be set, or the bridge refuses to start. Only the exact https
#           origins of the production frontend; no localhost, no previews:
#           ALLOWED_ORIGINS=https://getorchestra.xyz,https://www.getorchestra.xyz
# Setting it REPLACES the local default. Listing localhost in production is honoured but logs a warning.
# ALLOWED_ORIGINS=
# A staging bridge should use its own AGENT_PRIVATE_KEY / AGENT_WALLET_ADDRESS (never the production agent wallet).

# Local development only: POST /mock-trade injects a fake approval request. Off unless set to 1,
# and always off when NODE_ENV=production. Never set it on a deployed bridge.
# ENABLE_MOCK_TRADE=1

# Local development only: also log the text of each chat message ([intent <id>] message: "..."). Off
# unless set to exactly 1, and always off when NODE_ENV=production. By default the server log holds
# no message text, no plan summaries, no recipients and only shortened wallet addresses.
# LOG_USER_MESSAGES=1
